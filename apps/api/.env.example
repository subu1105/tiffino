# Copy to .env and fill in the real values. NEVER commit the real .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (URL-encode special characters in the password)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/tiffino_v2?retryWrites=true&w=majority

# Long random secret — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-hex-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# Comma-separated allowed web origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# true in production (HTTPS)
COOKIE_SECURE=false

# Used only by `pnpm seed` on an empty database
SEED_OWNER_EMAIL=owner@tiffino.local
SEED_OWNER_NAME=Tiffino Owner
SEED_OWNER_PASSWORD=change-me
